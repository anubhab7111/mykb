# qemu: -acpitable file=@SSDT@ -smbios type=2,manufacturer=HP,product=8A4E
# Bad input never reaches the firmware; lowercase, no newline and one color for all are accepted.
load readonly=0
write zones FF0000 00FF00\n
write zones #FF0000\n
write zones ff0000 00ff00 0000ff ffffff\n
read zones
write zones 40E0D0
read zones
write backlight 2\n
info writes_total
kmsg-clean
