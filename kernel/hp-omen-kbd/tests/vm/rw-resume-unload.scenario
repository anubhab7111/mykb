# qemu: -acpitable file=@SSDT@ -smbios type=2,manufacturer=HP,product=8A4E
# Unload while the re-apply is still pending: the work is cancelled before the restore. If it were
# not, its timer would fire into freed code during the sleep.
load readonly=0
write zones 112233 445566 778899 AABBCC\n
suspend
unload
kmsg restored the boot colors
sleep 2000
kmsg re-applying
kmsg-clean
