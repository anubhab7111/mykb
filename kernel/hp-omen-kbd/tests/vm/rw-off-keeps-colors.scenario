# qemu: -acpitable file=@SSDT@ -smbios type=2,manufacturer=HP,product=8A4E
# "Off" is the firmware backlight: the color table stays as it was (omen-space bug D2).
load readonly=0 restore_on_unload=0
write zones 112233 445566 778899 AABBCC\n
write backlight 0\n
read backlight
unload
load
read zones
read backlight
info backlight_raw
kmsg-clean
